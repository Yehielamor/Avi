#
# כל משתנה VITE_* נצרב לתוך ה-bundle ולכן הוא **ציבורי לחלוטין**.
# אסור לשים כאן סוד. לעולם. הקובץ הזה בגיט בכוונה, מהסיבה הזו.
# =============================================================================

# מקור ה-API. כרגע מנהור Cloudflare אל השרת שרץ מקומית.
#
# מנהור "מהיר" (ללא חשבון Cloudflare) מקבל כתובת חדשה בכל הפעלה.
# כשהוא נופל — צריך לעדכן כאן ולפרוס מחדש, כי הערך נצרב בבנייה.
# לפתרון קבוע: named tunnel, או פריסת השרת ל-VPS.
VITE_API_URL=https://national-yarn-starts-defensive.trycloudflare.com

# תת-הדומיין של הטננט.
#
# נדרש כי ה-API והממשק על דומיינים שונים: ה-Host שמגיע לשרת הוא של
# ה-API, ולכן אינו נושא את תת-הדומיין של הטננט. הערך נשלח ככותרת
# X-Tenant. זו הצהרה בלבד — עדיין נדרשת סיסמה תקפה של אותו טננט,
# ו-JwtAuthGuard דוחה טוקן שאינו תואם.
VITE_TENANT=ac-maintenance
