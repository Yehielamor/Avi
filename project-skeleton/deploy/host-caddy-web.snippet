# הממשק וה-API תחת מקור אחד: craftmind-ai.com.
#
# /v1/* עובר לאפליקציה, כל השאר הוא ה-SPA. מקור אחד פירושו שאין CORS ואין
# preflight לכל בקשה, ושאפשר לעבור לעוגיות HttpOnly (שבפיצול בין דומיינים
# נחסמות כעוגיות צד שלישי).
craftmind-ai.com {
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options    "nosniff"
		X-Frame-Options           "DENY"
		Referrer-Policy           "no-referrer"
		Permissions-Policy        "geolocation=(self), camera=(), microphone=(), payment=()"
		Cross-Origin-Opener-Policy "same-origin"
		-Server
	}

	request_body {
		max_size 25MB
	}

	handle /v1/* {
		@health path /v1/health/*
		respond @health 404
		reverse_proxy 127.0.0.1:3000
	}

	# אפליקציית הטכנאי (PWA). נפרדת מהממשק: build משלה, service worker
	# שה-scope שלו /field/ בלבד, ו-releases משלה (scripts/deploy-field.sh).
	redir /field /field/ permanent
	handle_path /field/* {
		root * /var/www/craftmind-field
		@manifest path /manifest.webmanifest
		header @manifest Content-Type application/manifest+json
		@hashed path /assets/*
		header @hashed Cache-Control "public, max-age=31536000, immutable"
		@entry path / /index.html /sw.js /manifest.webmanifest
		header @entry Cache-Control "no-cache"
		try_files {path} /index.html
		file_server
	}

	handle {
		root * /var/www/craftmind
		# קבצים עם hash בשם — לנצח. index.html ו-service worker — אף פעם לא,
		# אחרת משתמשים נתקעים על גרסה ישנה אחרי פריסה.
		@hashed path /assets/*
		header @hashed Cache-Control "public, max-age=31536000, immutable"
		@entry path / /index.html /sw.js /registerSW.js /manifest.webmanifest
		header @entry Cache-Control "no-cache"
		try_files {path} /index.html
		file_server
	}
}

www.craftmind-ai.com {
	redir https://craftmind-ai.com{uri} permanent
}
