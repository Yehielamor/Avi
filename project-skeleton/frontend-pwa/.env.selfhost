# =============================================================================
# בנייה לשרת שלנו: craftmind-ai.com מגיש גם את הממשק וגם את ה-API.
#
#   npx vite build --mode selfhost
#
# VITE_API_URL ריק = הבקשות הולכות ל-/v1 באותו מקור (ראו lib/api.ts), ו-Caddy
# מעביר אותן לאפליקציה. אין CORS, אין preflight, ועוגיות HttpOnly אפשריות.
#
# במצב הזה .env.production *לא* נטען — Vite טוען רק .env.[mode]. כך בניית
# Vercel ממשיכה לעבוד כמו קודם עד שהיא תכובה.
#
# כמו כל VITE_*: ציבורי לחלוטין, נצרב ל-bundle. אסור לשים כאן סוד.
# =============================================================================
VITE_API_URL=
VITE_TENANT=ac-maintenance
