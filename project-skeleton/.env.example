# =============================================================================
# CraftMind AI — משתני סביבה
#
# כל המשתנים כאן מאומתים ב-src/config/env.schema.ts בזמן *עלייה*.
# משתנה חסר או לא תקין מפיל את האפליקציה מיד, עם הודעה שאומרת בדיוק
# מה חסר — במקום ליפול בבקשה הראשונה, או גרוע מזה, ליפול ל-default
# לא בטוח. ראו docs/10-audit-findings.md#I1.
# =============================================================================

NODE_ENV=development
PORT=3000
LOG_LEVEL=debug

# --- Domain ---
# זיהוי טננט מ-subdomain: {tenant}.craftmind-ai.com
BASE_DOMAIN=craftmind-ai.com
# מקורות מותרים ל-CORS, מופרדים בפסיק. בפרודקשן חייב להיות מפורש.
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# =============================================================================
# Database — שני תפקידים, בכוונה. ראו docker/postgres/initdb/00-roles.sh
# =============================================================================

# סיסמת ה-superuser. משמשת *רק* לאתחול הקונטיינר; האפליקציה
# לעולם לא מתחברת איתה.
POSTGRES_SUPER_PASSWORD=replace_me_super

# craftmind_migrator — בעל הסכימה. מריץ מיגרציות בלבד.
CRAFTMIND_MIGRATOR_PASSWORD=replace_me_migrator

# craftmind_app — זהות זמן-הריצה. לא בעלים, ולכן RLS חל עליו.
CRAFTMIND_APP_PASSWORD=replace_me_app

# DATABASE_URL  = התפקיד שהאפליקציה משתמשת בו בזמן ריצה (RLS נאכף).
# DIRECT_DATABASE_URL = התפקיד ש-`prisma migrate` משתמש בו (בעלים).
# אסור להחליף ביניהם. החלפה = RLS מושבת לחלוטין וללא שגיאה.
DATABASE_URL="postgresql://craftmind_app:replace_me_app@localhost:5433/craftmind?schema=public&connection_limit=10&pool_timeout=20"
DIRECT_DATABASE_URL="postgresql://craftmind_migrator:replace_me_migrator@localhost:5433/craftmind?schema=public"

# --- Redis (תורי עבודה ו-rate limiting) ---
REDIS_URL=redis://localhost:6380

# =============================================================================
# Secrets — כל אחד חייב להיות ייחודי. אין fallbacks בקוד.
# =============================================================================

# חתימת טוקני התחברות. לפחות 32 תווים.
# ליצור: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=replace_with_long_random_string_min_32_chars
JWT_EXPIRES_IN=12h

# סוד *נפרד* לטוקן ה-state של OAuth. חייב להיות שונה מ-JWT_SECRET:
# כששניהם זהים, טוקן state שדולף מלוגים של Google הוא טוקן גישה
# תקף לאפליקציה. ראו docs/10-audit-findings.md#C6.
OAUTH_STATE_SECRET=replace_with_a_different_long_random_string

# הצפנת טוקני אינטגרציות at-rest. בדיוק 64 תווי hex (32 בתים).
# ליצור: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
INTEGRATION_ENCRYPTION_KEY=replace_with_64_char_hex_string
# גרסת המפתח הפעילה. להעלות ב-1 בכל רוטציה (ראו docs/04-infrastructure.md).
INTEGRATION_ENCRYPTION_KEY_VERSION=1
#
# רוטציה: מוסיפים את המפתח החדש כ-INTEGRATION_ENCRYPTION_KEY_V<N>,
# מעלים את VERSION, ומריצים הצפנה מחדש. המפתחות הישנים *נשארים*
# עד שכל השורות הוצפנו מחדש — הסרתם קודם הורסת כל טוקן שמור.
#   INTEGRATION_ENCRYPTION_KEY_V1=<the previous 64-char hex key>
#   INTEGRATION_ENCRYPTION_KEY_V2=<the new one>

# =============================================================================
# Google OAuth (Gmail + Drive)
# =============================================================================
# GOOGLE_REDIRECT_URI חייב להיות זהה אות-באות למה שרשום ב-Google Cloud
# Console, וחייב להיות דומיין הבסיס הקבוע — Google לא תומך ב-wildcard.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://craftmind-ai.com/integrations/google/callback

# =============================================================================
# LLM
# =============================================================================
# איזה ספק להשתמש. 'auto' בוחר את מי שמוגדר בפועל.
# ראו src/llm/llm.module.ts.
LLM_PROVIDER=auto

# --- Anthropic ---
ANTHROPIC_API_KEY=
# חילוץ מובנה ממייל/מסמך — נפח גבוה, משימה פשוטה.
ANTHROPIC_EXTRACTION_MODEL=claude-haiku-4-5-20251001
# שיחת onboarding — tool-use רב-תורי, דורש מודל חזק.
ANTHROPIC_ONBOARDING_MODEL=claude-sonnet-5

# --- Gemini ---
# יש לו מכסה חינמית, ולכן הוא חלופה נוחה לפיתוח. מפתח נוצר ב-
# https://aistudio.google.com/apikey
#
# שים לב: המכסה החינמית קטנה. תור אחד בשיחת onboarding יכול לצרוך
# כמה קריאות (כל סבב של tool-use הוא קריאה), ולכן היא נגמרת מהר.
# לפרודקשן — Anthropic או חבילת Gemini בתשלום.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# תקרות הוצאה. נאכפות ב-LlmBudgetService לפני כל קריאה.
LLM_DEFAULT_MONTHLY_BUDGET_MINOR=50000
LLM_MAX_INPUT_CHARS=40000
ONBOARDING_MAX_LLM_CALLS_PER_SESSION=60
ONBOARDING_SESSION_TTL_HOURS=72

# =============================================================================
# תשתית (compose בלבד — לא נקרא ע"י האפליקציה)
# =============================================================================
# נדרש ל-DNS-01 challenge של תעודת ה-wildcard. ראו Caddyfile.
CLOUDFLARE_API_TOKEN=
SHADOW_DATABASE_URL="postgresql://craftmind_migrator:replace_me_migrator@localhost:5433/craftmind_shadow?schema=public"
